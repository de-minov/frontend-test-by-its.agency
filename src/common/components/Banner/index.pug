include ../Breadcrumbs/index

section.banner
    +breadcrumbs([
        { text: 'Главная', href: '#' },
        { text: 'Продукты', href: '#' },
        { text: 'Краски', href: '#' },
    ]).banner__breadcrumbs

    .swiper.isDesktop
        .swiper-wrapper
            - var i = 6
            while i--
                .swiper-slide.banner__slide
                    img.banner__slide-background(src="/files/images/banners/banner-img.jpg" width="1920" height="560" alt=" " role="none")/
                    .banner__text
                        .banner__text-title Краски
                        .banner__text-description
                            | Идеально подходят для&nbsp;стен и&nbsp;других поверхностей.
                            br
                            | Найди свой идеальный цвет!

        .banner__navigation.banner__navigation--prev: +icon('icon:slider-button', 80, 80)
        .banner__navigation.banner__navigation--next: +icon('icon:slider-button', 80, 80)
        .banner__pagination